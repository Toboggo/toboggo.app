VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fond de carte MapLibre — URL d'un style JSON (spec « MapLibre Style » v8).
# Fournisseur retenu au démarrage : OpenFreeMap (gratuit, sans clé, données OSM).
# Provider-agnostic : remplacer par un style MapTiler / Protomaps / self-host suffit.
# Vide ⇒ l'app parents retombe sur la carte stylisée hors-ligne (FakeMap),
# le back-office affiche « Carte indisponible ».
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Géocodage MapTiler — recherche libre d'une ville/adresse/lieu (barre de
# recherche de l'app parents), indépendant du fond de carte ci-dessus. Sert
# uniquement à obtenir des coordonnées ; les parcs restent lus depuis la base
# Toboggo. Vide ⇒ la recherche de lieux est simplement désactivée.
VITE_MAPTILER_KEY=
