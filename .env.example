VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fond de carte MapLibre — URL d'un style JSON (spec « MapLibre Style » v8).
# Fournisseur retenu au démarrage : OpenFreeMap (gratuit, sans clé, données OSM).
# Provider-agnostic : remplacer par un style MapTiler / Protomaps / self-host suffit.
# Vide ⇒ l'app parents retombe sur la carte stylisée hors-ligne (FakeMap),
# le back-office affiche « Carte indisponible ».
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Géocodage MapTiler — recherche libre d'une ville/adresse/lieu (barre de
# recherche de l'app parents), indépendant du fond de carte ci-dessus. Sert
# uniquement à obtenir des coordonnées ; les parcs restent lus depuis la base
# Toboggo. Vide ⇒ la recherche de lieux est simplement désactivée.
VITE_MAPTILER_KEY=

# Product Analytics (PostHog) — app parents uniquement, voir
# apps/mobile/src/lib/analytics/ et docs/analytics/.
# UN SEUL projet PostHog pour Staging et Production (le plan actuel n'en
# permet qu'un) : les deux environnements sont séparés par la propriété
# commune `environment` (VITE_APP_ENV ci-dessous), jamais par projet séparé.
# Les 3 variables (clé, host, env) doivent être renseignées ENSEMBLE : si
# l'une des trois est absente ou invalide, l'analytics reste intégralement
# no-op — aucun appel à posthog.init(), aucune requête réseau PostHog. C'est
# l'état attendu en local, en CI, dans le Simulator et dans les sessions
# Claude Code — ne jamais renseigner ces variables pour ces usages.
# Ne JAMAIS mettre ici une clé de projet réelle : ce fichier est suivi par
# git. La configuration réelle est injectée uniquement via les variables
# d'environnement du déploiement (jamais commitée), à l'image de
# VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY ci-dessus.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Environnement applicatif réel — strictement "staging" ou "production",
# toute autre valeur (ou absence) désactive l'analytics (voir ci-dessus).
# Volontairement DISTINCTE du mode de build Vite (import.meta.env.MODE) :
# un build "production" peut être déployé sur l'environnement Staging, donc
# le mode de build seul ne suffit pas à savoir où l'app tourne réellement —
# cette variable est positionnée explicitement par le déploiement.
VITE_APP_ENV=
