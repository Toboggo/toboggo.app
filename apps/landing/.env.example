# Variables PUBLIQUES de build Astro (préfixe PUBLIC_ = injectées dans la page).
# Utilisées uniquement par le formulaire /contact (insertion anonyme dans
# contact_messages, protégée par RLS). Clé anon uniquement — JAMAIS de clé
# service_role. Copier vers apps/landing/.env.local (gitignoré) en local ;
# sur Vercel : Project Settings → Environment Variables (projet toboggo-website).
# Ces deux variables ne servent plus que de SECOURS : si elles manquent au build,
# le formulaire reste affiché et utilise uniquement /api/contact (voir CONTACT.md).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Variables SERVEUR (Vercel Function /api/contact) — JAMAIS préfixées PUBLIC_, à définir
# uniquement dans Vercel (Environment Variables), jamais dans le dépôt. Voir CONTACT.md.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
