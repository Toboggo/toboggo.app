# Variables PUBLIQUES de build Astro (préfixe PUBLIC_ = injectées dans la page).
# Utilisées uniquement par le formulaire /contact (insertion anonyme dans
# contact_messages, protégée par RLS). Clé anon uniquement — JAMAIS de clé
# service_role. Copier vers apps/landing/.env.local (gitignoré) en local ;
# sur Vercel : Project Settings → Environment Variables (projet toboggo-website).
# Si l'une des deux manque au build, /contact affiche un contact de secours par
# e-mail au lieu du formulaire.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Blog Sanity (projet 1m1y03h0, dataset production) ---
# Serveur uniquement : JAMAIS de préfixe PUBLIC_, jamais committé. Sur Vercel : Environment Variables du projet
# toboggo-website (Production + Preview). Voir docs/blog-sanity.md.
# Jeton Sanity « Viewer » (lecture seule). Requis pour la prévisualisation des brouillons ;
# optionnel pour le contenu publié tant que le dataset est public.
SANITY_API_READ_TOKEN=
# Facultatifs (valeurs par défaut : 1m1y03h0 / production)
SANITY_PROJECT_ID=
SANITY_DATASET=
