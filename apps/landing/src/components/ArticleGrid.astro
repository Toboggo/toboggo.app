---
/**
 * Grille d'articles réels (Sanity) — mêmes cartes que GuideGrid : 1 colonne < 640px, 3 colonnes ≥ 640px,
 * cartes de même hauteur, aucune largeur fixe. Chaque carte est un lien unique vers /guides/<slug>/.
 */
import type { ArticleCard } from "../lib/blog/types";
import { sanityImage, sanitySrcset } from "../lib/blog/images";
import { formatDate } from "../lib/blog/articles";

interface Props {
  articles: ArticleCard[];
  /** Niveau du titre des cartes : h3 sous un H2 de section (Home), h2 directement sous le H1 (/guides/). */
  headingLevel?: "h2" | "h3";
}

const { articles, headingLevel: Heading = "h3" } = Astro.props;
const SIZES = "(min-width: 1024px) 331px, (min-width: 640px) 229px, calc(100vw - 48px)";
---

<ul class="article-grid">
  {
    articles.map((a) => (
      <li class="article-card">
        <a class="article-link" href={`/guides/${a.slug}/`}>
          <div class="article-media">
            {a.cover?.url ? (
              <img
                src={sanityImage(a.cover.url, { w: 600, h: 400 })}
                srcset={sanitySrcset(a.cover.url, [400, 600, 900], 3 / 2)}
                sizes={SIZES}
                width="600"
                height="400"
                alt={a.cover.alt ?? ""}
                loading="lazy"
                decoding="async"
              />
            ) : null}
          </div>
          <div class="article-body">
            {a.category && <span class="article-cat">{a.category.title}</span>}
            <Heading class="article-title">{a.title}</Heading>
            <p class="article-excerpt">{a.excerpt}</p>
            <time class="article-date" datetime={a.publishedAt}>
              {formatDate(a.publishedAt)}
            </time>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: stretch;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-card {
    display: flex;
    min-width: 0;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .article-link {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .article-link:hover .article-title,
  .article-link:focus-visible .article-title {
    color: var(--color-primary-hover);
  }

  .article-media {
    flex: none;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-primary-tint);
  }

  .article-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-5);
  }

  .article-cat {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    padding: 5px 9px;
    border-radius: var(--radius-pill, 999px);
    background: var(--color-primary-tint);
    color: var(--color-primary-hover);
  }

  .article-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .article-excerpt {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .article-date {
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }

  @media (min-width: 640px) {
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .article-grid {
      gap: var(--space-5);
    }
  }
</style>
