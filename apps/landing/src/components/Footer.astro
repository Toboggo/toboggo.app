---
/**
 * Pied de page V2 : (1) optionnellement un grand CTA final, (2) une grille aérée marque / liens.
 *
 * - CTA final : affiché seulement quand la page le demande (`cta`, Home) ; les autres pages ont déjà
 *   leur propre appel à l'action. Badges App Store / Google Play : composant existant, qui ne rend
 *   RIEN tant qu'aucune URL réelle n'est configurée (config/site.ts).
 * - Pas de newsletter (aucun backend n'existe : pas de faux formulaire).
 * - Réseaux sociaux : uniquement ceux réellement configurés (SOCIAL_LINKS, vide aujourd'hui → rien).
 */
import Logo from "./Logo.astro";
import StoreBadges from "./StoreBadges.astro";
import { APP_URL, SOCIAL_LINKS } from "../config/site";
import { listSocials } from "../lib/social";
import { getDictionary, getLangFromUrl } from "../i18n/utils";

interface Props {
  /** Grand CTA final au-dessus du pied de page. */
  cta?: boolean;
}

const { cta = false } = Astro.props;
const dict = getDictionary(getLangFromUrl(Astro.url));
const socials = listSocials(SOCIAL_LINKS);
---

<footer class:list={["site-footer", { "site-footer--cta": cta }]}>
  {
    cta && (
      <section class="footer-cta" aria-labelledby="footer-cta-title">
        <div class="wrap">
          <div class="cta-card">
            <svg class="cta-decor" viewBox="0 0 360 360" aria-hidden="true">
              <circle cx="180" cy="180" r="96" class="cta-ring cta-ring--a" />
              <circle cx="180" cy="180" r="148" class="cta-ring cta-ring--b" />
              <circle cx="180" cy="180" r="200" class="cta-ring cta-ring--c" />
              <g transform="translate(236 132)">
                <path d="M0 0c-13-16-20-26-20-38a20 20 0 0 1 40 0c0 12-7 22-20 38z" class="cta-pin" />
                <circle cy="-38" r="7" class="cta-pin-dot" />
              </g>
            </svg>
            <div class="cta-copy">
              <h2 id="footer-cta-title">Le prochain parc préféré de votre famille est peut-être juste à côté.</h2>
              <div class="cta-actions">
                <a class="btn cta-btn" href={APP_URL}>Ouvrir Toboggo</a>
                <StoreBadges />
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <div class="wrap footer-main">
    <div class="footer-brand">
      <Logo size={44} />
      <p class="tagline">{dict.footer.tagline}</p>
      {
        socials.length > 0 && (
          <ul class="footer-social" aria-label="Réseaux sociaux">
            {socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <nav class="footer-col" aria-label={dict.footer.explorer.heading}>
      <p class="footer-title">{dict.footer.explorer.heading}</p>
      <a href={APP_URL}>{dict.footer.explorer.explorer}</a>
      <a href="/fonctionnalites/">{dict.footer.explorer.fonctionnalites}</a>
      <a href="/aires-de-jeux/">{dict.footer.explorer.airesDeJeux}</a>
      <a href="/guides/">{dict.footer.explorer.guides}</a>
      <a href="/collectivites/">{dict.footer.explorer.collectivites}</a>
    </nav>

    <nav class="footer-col" aria-label={dict.footer.aPropos.heading}>
      <p class="footer-title">{dict.footer.aPropos.heading}</p>
      <a href="/a-propos/#mission">{dict.footer.aPropos.mission}</a>
      <a href="/a-propos/#histoire">{dict.footer.aPropos.histoire}</a>
      <a href="/contact/">{dict.footer.aPropos.contact}</a>
      <a href="/faq/">{dict.footer.aPropos.aide}</a>
    </nav>

    <nav class="footer-col" aria-label={dict.footer.legal.heading}>
      <p class="footer-title">{dict.footer.legal.heading}</p>
      <a href="/cgu/#confidentialite">{dict.footer.legal.confidentialite}</a>
      <a href="/cgu/#cgu">{dict.footer.legal.cgu}</a>
      <a href="/mentions-legales/">{dict.footer.legal.mentionsLegales}</a>
      <a href="/cgu/#cookies">{dict.footer.legal.cookies}</a>
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p>{dict.footer.copyright}</p>
    <!-- Attribution OpenStreetMap : les données de parcs importées d'OSM sont sous
         licence ODbL, qui impose la mention « © OpenStreetMap contributors »
         avec un lien vers la page de licence. -->
    <p>
      {dict.footer.dataCredit}
      <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap contributors</a>
      (<a href="https://opendatacommons.org/licenses/odbl/" target="_blank" rel="noopener noreferrer">ODbL</a>)
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border-neutral);
  }

  /* avec le grand CTA, c'est la carte qui sépare la page du pied de page : pas de filet en plus */
  .site-footer--cta {
    border-top: 0;
  }

  /* ---- CTA final -------------------------------------------------------- */
  .footer-cta {
    padding: var(--space-8) 0 0;
    background: var(--color-bg);
  }

  .cta-card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 280px;
    padding: 56px 48px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    /* vert Toboggo foncé : le texte blanc reste lisible (≥ 4 :1) */
    background: linear-gradient(135deg, var(--color-primary-hover), var(--color-primary-pressed));
    color: var(--color-surface);
  }

  .cta-copy {
    position: relative;
    z-index: 1;
    max-width: 620px;
  }

  .cta-copy h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.15;
    color: var(--color-surface);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .cta-actions :global(.store-badges) {
    margin-top: 0;
  }

  .cta-btn {
    background: var(--color-surface);
    color: var(--color-primary-pressed);
    font-size: 17px;
    padding-inline: 32px;
  }

  .cta-btn:hover {
    background: var(--color-accent-tint);
    color: var(--color-primary-pressed);
  }

  /* Écho de la section « storytelling » : anneaux de recherche + un pin orange (décor pur) */
  .cta-decor {
    position: absolute;
    right: -40px;
    top: 50%;
    width: 420px;
    height: 420px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .cta-ring {
    fill: none;
    stroke: var(--color-surface);
    stroke-width: 1.5;
  }

  .cta-ring--a {
    stroke-opacity: 0.28;
    stroke-dasharray: 3 9;
    stroke-linecap: round;
  }

  .cta-ring--b {
    stroke-opacity: 0.18;
  }

  .cta-ring--c {
    stroke-opacity: 0.1;
  }

  .cta-pin {
    fill: var(--color-accent);
  }

  .cta-pin-dot {
    fill: var(--color-primary-pressed);
  }

  /* apparition de la carte pilotée par le défilement (CSS pur, aucun JS) : seulement si le navigateur le
     supporte et si les animations sont autorisées ; sinon la carte est simplement affichée. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cta-card {
        animation: cta-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }

      @keyframes cta-in {
        from {
          opacity: 0;
          transform: translateY(32px);
        }

        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

  /* ---- Grille du pied de page ------------------------------------------ */
  .footer-main {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-top: 72px;
    padding-bottom: 56px;
  }

  /* le logo est l'ancre visuelle du pied de page : plus grand que dans l'en-tête */
  .footer-brand :global(.brand) {
    font-size: 28px;
    gap: 12px;
  }

  .footer-brand .tagline {
    margin: var(--space-4) 0 0;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .footer-social a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-border-neutral);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .footer-social a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0;
    /* compense le padding bas du dernier lien : hauteur de la colonne inchangée au bureau */
    margin-bottom: -6px;
  }

  /* séparation nette entre les trois colonnes (Toboggo / À propos / Légal) */
  .footer-col + .footer-col {
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-border-neutral);
  }

  .footer-col .footer-title {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  /* petit repère orange sous chaque titre : hiérarchie titre → liens */
  .footer-col .footer-title::after {
    content: "";
    display: block;
    width: 24px;
    height: 3px;
    margin-top: var(--space-2);
    border-radius: 2px;
    background: var(--color-accent);
  }

  /* zone cliquable ≥ 31px au bureau (≥ 24px WCAG), 44px sur mobile */
  .footer-col a {
    position: relative;
    align-self: flex-start;
    padding-block: 6px;
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-surface));
    text-decoration: none;
    font-size: 15px;
    transition: color var(--duration-base) var(--ease-standard);
  }

  /* soulignement qui se dessine au survol/focus (transform uniquement) */
  .footer-col a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: var(--color-primary-hover);
  }

  .footer-col a:hover::after,
  .footer-col a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-col a,
    .footer-col a::after {
      transition: none;
    }
  }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-5);
    padding-bottom: var(--space-8);
    color: color-mix(in srgb, var(--color-text) 70%, var(--color-surface));
    font-size: var(--text-xs);
  }

  /* filet aligné sur le contenu (pas sur toute la largeur du conteneur) */
  .footer-bottom::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--space-6);
    right: var(--space-6);
    height: 1px;
    background: var(--color-border-neutral);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom a {
    color: inherit;
    text-decoration: underline;
  }

  .footer-bottom a:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 1000px) {
    .cta-decor {
      width: 340px;
      height: 340px;
      right: -90px;
    }
  }

  @media (max-width: 800px) {
    .cta-card {
      padding: 44px 28px;
    }

    .cta-decor {
      opacity: 0.55;
    }

    /* mobile/tablette : marque en haut, « Toboggo » pleine largeur (liens sur 2 colonnes),
       puis « À propos » et « Légal » côte à côte — beaucoup plus court qu'une longue liste */
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-5);
      padding-top: 52px;
      padding-bottom: 40px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-col + .footer-col {
      padding-left: 0;
      border-left: 0;
    }

    .footer-col:nth-child(2) {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-5);
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border-neutral);
    }

    .footer-col:nth-child(2) .footer-title {
      grid-column: 1 / -1;
    }

    .footer-col:nth-child(n + 3) {
      padding-top: var(--space-6);
      border-top: 1px solid var(--color-border-neutral);
    }

    .footer-col {
      margin-bottom: 0;
    }

    /* mobile : liens du pied de page à 44px de haut */
    .footer-col a {
      display: flex;
      align-items: center;
      align-self: stretch;
      min-height: 44px;
      padding-block: 0;
    }

    .footer-col a::after {
      bottom: 8px;
      right: auto;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .cta-card {
      min-height: 0;
      padding: 40px 22px 44px;
      text-align: center;
    }

    .cta-actions {
      justify-content: center;
    }

    /* petit écran : carte épurée, le décor passerait derrière le bouton */
    .cta-decor {
      display: none;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
