---
/** Carte icône + titre + texte. `icon` = id du sprite (voir public/icons-sprite.svg). */
interface Props {
  icon: string;
  title: string;
  text: string;
}

const { icon, title, text } = Astro.props;
---

<li class="info-card">
  <span class="info-card-icon">
    <svg width="24" height="24" aria-hidden="true"><use href={`/icons-sprite.svg#${icon}`} /></svg>
  </span>
  <h3>{title}</h3>
  {text && <p>{text}</p>}
</li>
