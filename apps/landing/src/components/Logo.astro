---
/**
 * Toboggo brand mark — port fidèle de
 * packages/design-system/src/components/Logo.tsx (seule source de vérité,
 * voir CLAUDE.md §9). Géométrie et couleurs copiées à l'identique : ne pas
 * improviser un tracé ou un dégradé ici. Corrige la dérive identifiée par
 * l'audit (#3DBE90 utilisé par erreur sur 4 des 5 pages historiques au lieu
 * du vrai #2FA37C).
 */
interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
}

const { size = 28, wordmark = true, class: className } = Astro.props;
const gradientId = `tg-${crypto.randomUUID().slice(0, 8)}`;
---

<a href="/" class:list={["brand", className]} aria-label="Toboggo — retour à l'accueil">
  <svg width={size} height={size} viewBox="0 0 56 56" role="img" aria-hidden="true" style="display:block;flex:none;">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2FA37C"></stop>
        <stop offset="1" stop-color="#1F7D5F"></stop>
      </linearGradient>
    </defs>
    <rect width="56" height="56" rx="16" fill={`url(#${gradientId})`}></rect>
    <path d="M17 15 L39 15 M28 15 L28 30" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"></path>
    <path d="M28 30 C28 39 34 39 34 45" fill="none" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round"></path>
    <circle cx="34" cy="45" r="4.2" fill="#FFB020"></circle>
  </svg>
  {wordmark && <span class="brand-word">Toboggo</span>}
</a>

<style>
  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-text);
    text-decoration: none;
  }

  /* zone cliquable ≥ 44px de haut, sans changer la mise en page */
  .brand::after {
    content: "";
    position: absolute;
    inset: -8px -4px;
  }
</style>
