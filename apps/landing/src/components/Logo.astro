---
/**
 * Logo officiel Toboggo — fichier du kit v3 servi tel quel (public/brand/*.svg, copies
 * octet pour octet de docs/brand-kit-v3/logo/, vérifiées par src/lib/brand.test.ts).
 * Aucun redessin, aucune recomposition : ne pas rétablir un badge, un dégradé ou un texte.
 *
 * `size` = hauteur du logo en px (le ratio 1424×370 du fichier est conservé).
 * `variant` : "color" sur fond clair, "white" sur fond vert/photo sombre.
 */
interface Props {
  size?: number;
  variant?: "color" | "white";
  class?: string;
}

const { size = 40, variant = "color", class: className } = Astro.props;
const RATIO = 1424 / 370;
const width = Math.round(size * RATIO);
---

<a href="/" class:list={["brand", className]} aria-label="Toboggo — retour à l'accueil">
  <img src={`/brand/toboggo-${variant}.svg`} width={width} height={size} alt="" decoding="async" />
</a>

<style>
  .brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    display: block;
    height: auto;
    max-width: 100%;
  }

  /* zone cliquable ≥ 44px de haut, sans changer la mise en page */
  .brand::after {
    content: "";
    position: absolute;
    inset: -8px -4px;
  }
</style>
