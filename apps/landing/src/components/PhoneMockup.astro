---
/**
 * Cadre de téléphone 100% CSS/HTML autour d'une vraie capture de
 * apps/mobile (voir apps/landing/public/screenshots/, générées par
 * scripts/marketing-captures/capture-website2.mjs). La capture elle-même
 * n'est jamais modifiée — uniquement un habillage visuel autour.
 */
interface Props {
  src: string;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<div class:list={["phone", className]}>
  <div class="phone-notch"></div>
  <img src={src} alt={alt} loading="lazy" decoding="async" width="375" height="812" />
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 375 / 812;
    border-radius: 34px;
    background: var(--color-text);
    padding: 10px;
    box-shadow: var(--shadow-lg);
  }

  .phone img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 24px;
  }

  .phone-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 38%;
    height: 16px;
    background: var(--color-text);
    border-radius: 0 0 12px 12px;
    z-index: 1;
  }
</style>
