---
/**
 * Cadre de téléphone 100% CSS/HTML autour d'une vraie capture de apps/mobile (voir
 * apps/landing/public/screenshots/). La capture n'est JAMAIS modifiée : aucun
 * filtre, aucun voile, aucune surcouche sur l'écran (rien ne masque l'interface) —
 * uniquement un habillage autour : cadre métal, caméra dans le cadre, boutons latéraux,
 * reflet sur la tranche, ombres.
 */
interface Props {
  /** Capture unique. Sans `src`, le contenu du <slot> remplit l'écran (ex. captures empilées en fondu). */
  src?: string;
  alt?: string;
  class?: string;
  /** `eager` pour un téléphone visible dès le premier écran (Hero) ; `lazy` ailleurs. */
  loading?: "lazy" | "eager";
}

const { src, alt = "", class: className, loading = "lazy" } = Astro.props;
---

<div class:list={["phone", className]}>
  <span class="phone-btn phone-btn--action" aria-hidden="true"></span>
  <span class="phone-btn phone-btn--vol-up" aria-hidden="true"></span>
  <span class="phone-btn phone-btn--vol-down" aria-hidden="true"></span>
  <span class="phone-btn phone-btn--power" aria-hidden="true"></span>
  <div class="phone-screen">
    {src ? <img src={src} alt={alt} loading={loading} decoding="async" width="375" height="812" /> : <slot />}
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    padding: 9px;
    border-radius: 40px;
    /* cadre : dégradé métal sombre + liseré clair sur la tranche */
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-text) 62%, var(--color-surface)) 0%,
      var(--color-text) 38%,
      color-mix(in srgb, var(--color-text) 84%, black) 100%
    );
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--color-surface) 28%, transparent),
      inset 0 0 0 4px color-mix(in srgb, black 55%, transparent),
      0 18px 32px -20px color-mix(in srgb, var(--color-text) 38%, transparent),
      0 4px 10px -6px color-mix(in srgb, var(--color-text) 28%, transparent);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    /* ratio EXACT des captures (375×812) : l'écran n'est jamais rogné, quelle que soit
       la largeur du cadre (le padding du cadre s'ajoute autour, pas dans le ratio). */
    aspect-ratio: 375 / 812;
    overflow: hidden;
    border-radius: 31px;
    background: var(--color-text);
  }

  .phone-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* Caméra : un point dans le cadre, au-dessus de l'écran (rien sur la capture). */
  .phone::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 50%;
    width: 5px;
    height: 5px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: black;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-surface) 18%, transparent);
  }

  .phone-btn {
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-text) 58%, var(--color-surface));
  }

  .phone-btn--action {
    left: -2px;
    top: 14%;
    height: 3.2%;
  }

  .phone-btn--vol-up {
    left: -2px;
    top: 20%;
    height: 6%;
  }

  .phone-btn--vol-down {
    left: -2px;
    top: 27.5%;
    height: 6%;
  }

  .phone-btn--power {
    right: -2px;
    top: 22%;
    height: 9%;
  }
</style>
