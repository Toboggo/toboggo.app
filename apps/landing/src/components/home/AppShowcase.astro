---
/**
 * Aperçu de l'app : les 4 vraies captures du registre (lib/screens.ts), jamais retouchées,
 * mises en scène dans un cadre de téléphone (voir PhoneMockup). Sur desktop les téléphones
 * se chevauchent légèrement en éventail sur un fond doux ; sur mobile, défilement horizontal.
 * Les captures montrent les vrais parcs de Millau (sans photo : aucune photo aux droits
 * documentés) ; la fiche « Aire de jeux de Gourg de bade » est l'écran principal (grand, en premier) ;
 * Explorer, Filtres et Favoris sont secondaires. Aucun chevauchement, aucune rotation.
 */
import Button from "../Button.astro";
import PhoneMockup from "../PhoneMockup.astro";
import StoreBadges from "../StoreBadges.astro";
import { APP_URL } from "../../config/site";
import { appScreen } from "../../lib/screens";

const SCREENS = ["park-detail", "explorer", "filters", "favorites"]
  .map((id) => appScreen(id))
  .filter((screen): screen is NonNullable<ReturnType<typeof appScreen>> => screen !== null);
---

<section id="app-toboggo" class="app-showcase">
  <div class="wrap app-head">
    <span class="eyebrow">L'app Toboggo</span>
    <h2>Tout pour des sorties réussies en famille.</h2>
    <p class="app-sub">Carte, filtres, fiches détaillées et favoris : voici l'application.</p>
  </div>

  <div class="stage">
    <div class="stage-bg" aria-hidden="true">
      <svg class="stage-doodle stage-doodle--left" width="64" height="64" viewBox="0 0 46 46">
        <path d="M6 30 Q16 6 40 14" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 9" />
      </svg>
      <svg class="stage-doodle stage-doodle--right" width="64" height="64" viewBox="0 0 46 46">
        <path d="M40 30 Q30 6 6 14" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 9" />
      </svg>
    </div>

    <div class="phones-scroll" role="region" aria-label="Aperçu des écrans de l'application" tabindex="0">
      <div class="phones-track">
        {
          SCREENS.map((screen, i) => (
            <figure class:list={["phone-item", `phone-item--${i}`, { "phone-item--featured": screen.id === "park-detail" }]}>
              <PhoneMockup src={screen.src} alt={screen.alt} />
              <figcaption>{screen.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>

  <div class="wrap app-cta">
    <div class="app-cta-buttons">
      <Button href={APP_URL}>Ouvrir l'app Toboggo</Button>
      <Button href="/fonctionnalites/" variant="secondary">Découvrir toutes les fonctionnalités</Button>
    </div>
    <StoreBadges align="center" />
  </div>
</section>

<style>
  .app-showcase {
    padding: var(--space-8) 0 88px;
    /* blanc pur : rupture nette avec la section vert d'eau juste au-dessus, et les
       téléphones ressortent mieux sur blanc. */
    background: var(--color-surface);
    overflow: hidden;
  }

  .app-head {
    text-align: center;
  }

  .app-head h2 {
    font-size: 30px;
    margin: var(--space-3) 0 var(--space-2);
  }

  .app-sub {
    margin: 0 auto var(--space-8);
    max-width: 460px;
    color: var(--color-text-muted);
  }

  .stage {
    position: relative;
  }

  /* Halo doux derrière les téléphones */
  .stage::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(760px, 120%);
    aspect-ratio: 1.6;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-primary-tint), transparent 72%);
    pointer-events: none;
  }

  .stage-doodle {
    display: none;
  }

  .phones-scroll {
    position: relative;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-3);
  }

  .phones-track {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-4) var(--space-6) var(--space-4);
    width: max-content;
    min-width: 100%;
  }

  .phone-item {
    flex: 0 0 auto;
    width: 176px;
    margin: 0;
    scroll-snap-align: center;
  }

  .phone-item--featured {
    width: 232px;
  }

  .phone-item figcaption {
    width: fit-content;
    margin: var(--space-4) auto 0;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13.5px;
    white-space: nowrap;
  }

  .app-cta {
    text-align: center;
    margin-top: 56px;
  }

  .app-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-item {
      transition: transform var(--duration-base) var(--ease-standard);
    }
  }

  @media (min-width: 1024px) {
    .phones-scroll {
      overflow: visible;
    }

    .phones-track {
      justify-content: center;
      align-items: flex-end;
      width: auto;
      max-width: 1080px;
      margin: 0 auto;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6) var(--space-5);
    }

    /* Hiérarchie : la fiche vitrine (Gourg de bade) est l'écran principal, grande et en
       premier ; les trois autres sont secondaires, plus petits, alignés sur la même ligne
       de base. Côte à côte : aucun chevauchement, aucune rotation, captures entières. */
    .phone-item {
      width: 188px;
      position: relative;
    }

    .phone-item--featured {
      width: 300px;
    }

    .phone-item--featured figcaption {
      font-size: 15px;
    }

    .stage-doodle {
      display: block;
      position: absolute;
      top: 8%;
      opacity: 0.6;
    }

    .stage-doodle--left {
      left: 12%;
    }

    .stage-doodle--right {
      right: 12%;
    }
  }
</style>
