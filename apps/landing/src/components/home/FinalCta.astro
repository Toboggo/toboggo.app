---
/** Rappel final de la Home : mêmes boutons que le hero (CTA app + stores si disponibles). */
import Button from "../Button.astro";
import StoreBadges from "../StoreBadges.astro";
import { APP_URL } from "../../config/site";
---

<section class="final-cta">
  <div class="wrap final-inner">
    <h2>Prêt à trouver votre prochain parc ?</h2>
    <p>Ouvrez Toboggo : la carte autour de vous, les filtres par âge et par équipements, vos favoris.</p>
    <div class="final-actions">
      <Button href={APP_URL}>Ouvrir l'app Toboggo</Button>
      <Button href="/fonctionnalites/" variant="secondary">Voir les fonctionnalités</Button>
    </div>
    <StoreBadges align="center" />
  </div>
</section>

<style>
  .final-cta {
    padding: 88px 0 120px;
    background: var(--color-primary-tint);
    text-align: center;
  }

  .final-inner h2 {
    font-size: 30px;
    margin: 0 0 var(--space-3);
  }

  .final-inner p {
    max-width: 520px;
    margin: 0 auto var(--space-6);
    color: var(--color-text-muted);
  }

  .final-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
