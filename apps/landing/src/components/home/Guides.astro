---
/**
 * "Nos derniers guides & idées" (Website-2 §8) — 3 sujets « à venir »,
 * pas de vraies pages articles. Données (dont les photos réelles et leurs
 * alt) : ../../data/demoGuides.ts et apps/landing/public/images/IMAGE-SOURCES.md.
 *
 * Structure : titre → grille (GuideGrid) → footer de section séparé qui porte
 * le CTA. Le CTA est dans le flux, sous la grille : sa position ne dépend
 * jamais de la hauteur des cartes.
 */
import Button from "../Button.astro";
import GuideGrid from "../GuideGrid.astro";
---

<section class="guides">
  <div class="wrap">
    <h2>Nos derniers guides & idées</h2>
    <GuideGrid />
    <div class="guides-footer">
      <Button href="/guides/" variant="secondary">Voir tous les articles</Button>
    </div>
  </div>
</section>

<style>
  .guides {
    /* davantage d'air avant le footer */
    padding: var(--space-8) 0 120px;
  }

  .guides h2 {
    text-align: center;
    font-size: 30px;
    margin: 0 0 var(--space-7);
  }

  .guides-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
