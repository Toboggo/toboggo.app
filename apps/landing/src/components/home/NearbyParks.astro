---
/**
 * "Des parcs près de chez vous" (Website-2 §3) — démonstration visuelle,
 * PAS un Explorer web fonctionnel. Données : parcs réels de Millau lus depuis
 * Supabase au build (lib/seo/homeParks.ts), avec l'instantané data/demoParks.ts
 * en repli. Photos à ajouter uniquement quand leurs droits sont établis — aucune ici.
 */
import PhotoPlaceholder from "../PhotoPlaceholder.astro";
import Button from "../Button.astro";
import { getHomeParks } from "../../lib/seo/homeParks";

// Parcs réels de la ville pilote (Supabase, lus au build) ; instantané statique
// en repli si les variables manquent. Aucune photo : droits non établis.
const { cards, cityLink, cityName } = await getHomeParks(import.meta.env);
---

<section class="nearby">
  <div class="wrap">
    <h2>Des parcs près de chez vous</h2>
    <p class="nearby-sub">Un aperçu des aires de jeux référencées à {cityName}, avec leurs informations essentielles.</p>
  </div>

  <div class="nearby-wrap">
    <div class="nearby-scroll" id="nearby-scroll" role="region" aria-label="Aperçu de parcs" tabindex="0">
      <div class="nearby-track">
        {
          cards.map((park) => (
            <article class="park-card">
              {park.image || park.icons.length === 0 ? (
                <PhotoPlaceholder alt={park.imageAlt ?? park.name} ratio="1 / 1" src={park.image} />
              ) : (
                <div class="park-tile" aria-hidden="true">
                  {park.icons.slice(0, 6).map((icon) => (
                    <svg width="28" height="28"><use href={`/icons-sprite.svg#${icon}`} /></svg>
                  ))}
                </div>
              )}
              <h3>{park.name}</h3>
              {park.ageLabel && <p class="park-attr">{park.ageLabel}</p>}
              <p class="park-feats">{park.features.slice(0, 3).join(" · ")}</p>
            </article>
          ))
        }
      </div>
    </div>

    <button type="button" class="nearby-arrow nearby-arrow--prev" id="nearby-prev" aria-label="Parcs précédents" aria-controls="nearby-scroll">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 5L8 12L15 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button type="button" class="nearby-arrow nearby-arrow--next" id="nearby-next" aria-label="Parcs suivants" aria-controls="nearby-scroll">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 5L16 12L9 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  {
    cityLink && (
      <div class="wrap nearby-cta">
        <Button href={cityLink.href} variant="secondary">{cityLink.label}</Button>
      </div>
    )
  }
</section>

<script>
  const scroller = document.getElementById("nearby-scroll");
  const prevBtn = document.getElementById("nearby-prev");
  const nextBtn = document.getElementById("nearby-next");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function step(direction: 1 | -1) {
    if (!scroller) return;
    const card = scroller.querySelector(".park-card");
    const cardWidth = card ? card.getBoundingClientRect().width : 280;
    scroller.scrollBy({
      left: direction * (cardWidth + 24),
      behavior: reduceMotion ? "auto" : "smooth",
    });
  }

  prevBtn?.addEventListener("click", () => step(-1));
  nextBtn?.addEventListener("click", () => step(1));
</script>

<style>
  .nearby {
    /* davantage d'air avant "Comment ça marche ?" */
    padding: var(--space-8) 0 72px;
  }

  .nearby h2 {
    text-align: center;
    font-size: 30px;
  }

  .nearby-sub {
    text-align: center;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: var(--space-2) auto var(--space-7);
  }

  .nearby-wrap {
    position: relative;
  }

  /*
    Volontairement un carousel horizontal à TOUTES les tailles (pas de bascule
    en grille catalogue sur desktop) : sensation de découverte, la carte
    suivante peut peek partiellement, plutôt que de forcer les 6 cartes
    entièrement visibles.
  */
  .nearby-scroll {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    /* scrollbar native masquée (Parcs uniquement) — trackpad/molette/swipe
       restent natifs, seule l'apparence de la barre change. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nearby-scroll::-webkit-scrollbar {
    display: none;
  }

  .nearby-track {
    display: flex;
    /* flex-start, pas le stretch par défaut : sinon le placeholder (height:
       100%) prend la hauteur de la carte la plus haute de la ligne au lieu de
       respecter son aspect-ratio, et pousse le nom du parc hors du flux
       visuel (régression découverte en QA, pas liée au ratio en lui-même). */
    align-items: flex-start;
    gap: var(--space-5);
    padding: 0 var(--space-6) var(--space-3);
  }

  .park-card {
    flex: 0 0 auto;
    width: 200px;
    scroll-snap-align: start;
  }

  /* Habillage sans photo : pictogrammes des équipements réellement déclarés
     (jamais une image générique à la place du parc). */
  .park-tile {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    place-items: center;
    align-content: center;
    gap: var(--space-5) var(--space-3);
    aspect-ratio: 1 / 1;
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-primary-tint);
    color: var(--color-primary);
  }

  .park-tile svg {
    width: 32px;
    height: 32px;
  }

  .nearby-cta {
    text-align: center;
    margin-top: var(--space-6);
  }

  .park-card h3 {
    margin: var(--space-3) 0 2px;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .park-attr {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 13px;
  }

  .park-feats {
    margin: 2px 0 0;
    color: var(--color-text-faint);
    font-size: 12.5px;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .park-card {
      transition: transform var(--duration-base) var(--ease-standard);
    }

    .park-card:hover {
      transform: translateY(-4px);
    }
  }

  /* Flèches : discrètes, desktop uniquement — en dessous, le swipe natif
     suffit et des flèches flottantes gênent plus qu'elles n'aident. */
  .nearby-arrow {
    display: none;
  }

  @media (min-width: 768px) {
    .park-card {
      width: 240px;
    }
  }

  @media (min-width: 1024px) {
    .nearby-track {
      max-width: 1080px;
      margin: 0 auto;
      gap: var(--space-6);
    }

    .park-card {
      width: 260px;
    }

    .nearby-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 40%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: var(--color-surface);
      color: var(--color-text);
      box-shadow: var(--shadow-md);
      cursor: pointer;
      opacity: 0.85;
    }

    .nearby-arrow:hover {
      opacity: 1;
    }

    .nearby-arrow--prev {
      left: 4px;
    }

    .nearby-arrow--next {
      right: 4px;
    }
  }
</style>
