---
/**
 * Hub /aires-de-jeux/ — racine SEO. Ne liste QUE les pages de ville réellement
 * générées (validées éditorialement ET éligibles : lib/seo/seoSite.ts), groupées
 * par département. Indexable seulement s'il y a au moins une ville ; sinon
 * noindex,follow (et hors sitemap : voir astro.config.mjs).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Button from "../../components/Button.astro";
import { HUB_PATH, placePath } from "../../lib/seo/places";
import { loadSeoSite } from "../../lib/seo/seoSite";
import { groupByDepartment } from "../../lib/seo/hub";
import { breadcrumbLd, citiesItemListLd } from "../../lib/seo/jsonld";

const site = await loadSeoSite(import.meta.env);
const cities = site?.published ?? [];
const indexable = site?.hubIndexable ?? false;
const departments = groupByDepartment(cities);

const jsonLd = [
  breadcrumbLd([
    { name: "Accueil", path: "/" },
    { name: "Aires de jeux", path: HUB_PATH },
  ]),
  ...(indexable ? [citiesItemListLd(cities)] : []),
];
---

<BaseLayout
  title="Aires de jeux : trouvez un parc par ville"
  description="Trouvez les aires de jeux adaptées à vos enfants avec Toboggo : tranche d'âge, équipements et accessibilité. Découvrez Millau, notre première ville."
  robots={indexable ? undefined : "noindex,follow"}
  jsonLd={jsonLd}
>
  <section class="hub-hero">
    <div class="wrap">
      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Aires de jeux" }]} />
      <h1>Aires de jeux</h1>
      <p class="lead">
        Toboggo aide les familles à trouver les aires de jeux adaptées à leurs enfants : tranche d'âge, équipements, services et accessibilité, sur une seule application.
      </p>
    </div>
  </section>

  <section class="page-section page-section--tint">
    <div class="wrap narrow">
      <div class="section-head">
        <h2>Villes disponibles</h2>
        <p>Millau est notre première ville : les aires de jeux y sont référencées avec leur adresse et leurs équipements déclarés.</p>
      </div>
      {
        indexable ? (
          departments.map((dep) => (
            <div class="department">
              <h3>{dep.name}</h3>
              <ul class="card-grid city-list">
                {dep.places.map((c) => (
                  <li class="info-card">
                    <h4>
                      <a href={placePath(c.place)}>Aires de jeux à {c.place.name}</a>
                    </h4>
                    <p>{c.listed.length} {c.listed.length > 1 ? "aires de jeux référencées" : "aire de jeux référencée"}.</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        ) : (
          <p class="note">Aucune ville n'est disponible pour le moment.</p>
        )
      }
    </div>
  </section>

  <section class="page-cta">
    <div class="wrap">
      <h2>Découvrez Toboggo</h2>
      <p>Une carte, des filtres par âge et par équipements, des favoris : tout pour choisir le bon parc.</p>
      <div class="page-actions">
        <Button href="/#app-toboggo">Découvrir Toboggo</Button>
        <Button href="/fonctionnalites/" variant="secondary">Voir les fonctionnalités</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero {
    padding: var(--space-6) 0 56px;
    background: var(--color-surface);
  }

  .hub-hero h1 {
    font-size: clamp(30px, 6vw, 46px);
    margin: var(--space-5) 0 var(--space-3);
  }

  .hub-hero .lead {
    max-width: 640px;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 17px;
  }

  .narrow {
    max-width: 720px;
  }

  .department + .department {
    margin-top: var(--space-6);
  }

  .department h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .city-list .info-card h4 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }

  .city-list .info-card h4 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .city-list .info-card h4 a:hover {
    color: var(--color-primary-hover);
  }
</style>
