---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
---

<BaseLayout
  title="Contact"
  description="Une question, un problème ? Contactez l'équipe Toboggo ou utilisez le bouton Signaler depuis l'app."
>
  <Container class="contact-container">
    <div class="doc-section" style="max-width:960px;">
      <h1>Une question, un problème ?</h1>
      <p style="color:var(--color-text-muted);">
        Pour un parc endommagé ou une information erronée, utilisez plutôt le bouton « Signaler » depuis la fiche du
        parc dans l'app — c'est traité plus vite.
      </p>

      <div class="contact-grid" style="margin-top:32px;">
        <div>
          <div class="contact-card"><strong>Support général</strong><br /><a href="mailto:contact@toboggo.app">contact@toboggo.app</a></div>
          <div class="contact-card"><strong>Presse</strong><br /><a href="mailto:presse@toboggo.app">presse@toboggo.app</a></div>
          <div class="contact-card"><strong>Confidentialité RGPD</strong><br /><a href="mailto:privacy@toboggo.app">privacy@toboggo.app</a></div>
        </div>

        <div>
          <div id="form-msg"></div>
          <form id="contact-form">
            <div class="form-field">
              <label for="name">Nom</label>
              <input id="name" name="name" required />
            </div>
            <div class="form-field">
              <label for="email">E-mail</label>
              <input id="email" name="email" type="email" required />
            </div>
            <div class="form-field">
              <label for="subject">Sujet</label>
              <select id="subject" name="subject">
                <option>Question générale</option>
                <option>Problème technique</option>
                <option>Partenariat</option>
                <option>Presse</option>
              </select>
            </div>
            <div class="form-field">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>
            <button class="btn btn-primary" type="submit" id="submit-btn">Envoyer</button>
          </form>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<!-- window.TOBOGGO_CONFIG (Supabase URL + clé anon publique) — voir public/config.js.
     Clé anon uniquement, jamais de secret : c'est exactement ce que les policies
     RLS Supabase sont conçues pour exposer côté client. -->
<script is:inline src="/config.js"></script>
<script is:inline>
  const form = document.getElementById("contact-form");
  const msgEl = document.getElementById("form-msg");
  const btn = document.getElementById("submit-btn");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    msgEl.innerHTML = "";
    const cfg = window.TOBOGGO_CONFIG;
    if (!cfg || cfg.SUPABASE_URL.includes("YOUR-PROJECT")) {
      msgEl.innerHTML =
        '<div class="form-msg error">Le formulaire n\'est pas encore connecté (config.js à renseigner). Écrivez-nous directement à contact@toboggo.app.</div>';
      return;
    }
    btn.disabled = true;
    btn.textContent = "Envoi…";
    const payload = {
      name: document.getElementById("name").value,
      email: document.getElementById("email").value,
      subject: document.getElementById("subject").value,
      message: document.getElementById("message").value,
    };
    try {
      const res = await fetch(`${cfg.SUPABASE_URL}/rest/v1/contact_messages`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          apikey: cfg.SUPABASE_ANON_KEY,
          Authorization: `Bearer ${cfg.SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(await res.text());
      msgEl.innerHTML = '<div class="form-msg success">🎉 Message envoyé — notre équipe vous répondra sous peu.</div>';
      form.reset();
    } catch (err) {
      msgEl.innerHTML =
        '<div class="form-msg error">Une erreur est survenue. Écrivez-nous directement à contact@toboggo.app.</div>';
    } finally {
      btn.disabled = false;
      btn.textContent = "Envoyer";
    }
  });
</script>
