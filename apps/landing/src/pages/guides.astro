---
/**
 * Index éditorial (Website-3A). AUCUN article n'existe : les 3 sujets de
 * data/demoGuides.ts sont présentés comme « à venir », sans date, auteur,
 * catégorie ni lien. Pas de route /guides/[slug] tant qu'il n'y a pas de vrai
 * article. Reste noindex et hors sitemap (voir astro.config.mjs).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import GuideGrid from "../components/GuideGrid.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Guides & idées"
  description="Les guides et idées de sorties Toboggo arrivent bientôt : choisir une aire de jeux, préparer une sortie en famille."
  noindex
>
  <PageHero
    eyebrow="Guides & idées"
    title="Des conseils pour mieux choisir vos sorties."
    lead="Nos premiers guides sont en préparation. Voici les sujets que nous prévoyons d'aborder."
  />

  <section class="page-section page-section--tint">
    <div class="wrap">
      <GuideGrid />
      <p class="note">Aucun guide n'est encore publié. En attendant, la FAQ répond aux questions les plus fréquentes.</p>
      <div class="guides-footer">
        <Button href="/faq/" variant="secondary">Consulter la FAQ</Button>
        <Button href="/fonctionnalites/" variant="secondary">Découvrir les fonctionnalités</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .guides-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
