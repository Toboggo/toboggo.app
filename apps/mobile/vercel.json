{
  "rewrites": [
    {
      "source": "/park/:id",
      "destination": "/api/park-meta?id=:id"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sw\\.js|index\\.html|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(assets/.*|workbox-[A-Za-z0-9_-]+\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/park-meta.ts": {
      "includeFiles": "{dist/index.html,src/i18n/locales/**}"
    }
  }
}
